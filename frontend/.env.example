# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000

# n8n Webhook URL for AI processing
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/askai

# Product branding (NEXORA AI)
VITE_PRODUCT_NAME=NEXORA AI
VITE_PRODUCT_SUBTITLE=AI Agent Automation Platform
