# ============================================================
# NEXORA AI - Backend Environment Template
# ------------------------------------------------------------
# Copy this file to ".env" in the backend folder.
# Never commit real secrets to git.
# ============================================================

# ---------- Server ----------
PORT=5000

# ---------- PostgreSQL Database ----------
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_ai

# ---------- JWT (login token security) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_a_long_random_secret_here_min_32_chars

# ---------- CORS ----------
# Frontends allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------- Ollama AI ----------
# Ollama runs at OLLAMA_BASE_URL. Models tagged ":cloud" are served by
# Ollama's servers, so they are fast even on a machine with no GPU.
# Models without the tag run locally on the CPU and are far slower
# (roughly 10 tokens/second for a 0.8B model on a CPU-only laptop).
#
# gemma4:31b-cloud is included in Ollama's free usage tier.
# Other ":cloud" models may return HTTP 402 unless credits are added.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Embeddings must be a local model (used for RAG vector search).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vision model. Uses the same fast cloud model. A local vision model
# such as llava is 4.7 GB and needs minutes just to load from disk on
# a machine without a GPU.
OLLAMA_VISION_MODEL=gemma4:31b-cloud

# How long to wait for a model response before giving up.
OLLAMA_TIMEOUT_MS=120000

# ---------- External AI Providers (optional) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------- Redis (queue/caching) ----------
REDIS_URL=redis://localhost:6379

# ---------- Product Branding ----------
PRODUCT_NAME=NEXORA AI
PRODUCT_SUBTITLE=AI Agent Automation Platform
