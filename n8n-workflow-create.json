{
  "name": "Tech AI Ask AI",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "askai",
        "responseMode": "responseNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL || 'http://host.docker.internal:5000'}}/api/diagnosis",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.token}}"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "problem",
              "value": "={{$json.problem}}"
            },
            {
              "name": "projectId",
              "value": "={{$json.projectId}}"
            }
          ]
        },
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "name": "Create Diagnosis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "options": {
          "responseData": "={{$json}}",
          "responseCode": 200,
          "responseHeaders": {}
        }
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Create Diagnosis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Diagnosis": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
