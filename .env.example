# ============================================================
# NEXORA AI - Root Environment Template
# ------------------------------------------------------------
# Copy this file to ".env" in the project root.
# This file provides values for docker-compose.yml.
# ============================================================

# PostgreSQL password (docker compose creates a new database with this)
DB_PASSWORD=your_db_password_here

# JWT secret for backend authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_a_long_random_secret_here_min_32_chars

# Ollama configuration (local AI provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:latest

# External AI provider API keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
